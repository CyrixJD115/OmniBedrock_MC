    "/instances": {
      "get": {
        "tags": ["instances"],
        "summary": "Instances the signed-in user can access (default instance + shared ones)",
        "x-permission": "any signed-in user",
        "responses": { "200": { "description": "Array of instance summaries + usage" } }
      },
      "post": {
        "tags": ["instances"],
        "summary": "Create an instance (quota + port availability checked; id derives from name)",
        "x-permission": "INSTANCES_CREATE",
        "requestBody": {
          "x-body": {
            "name": "string 1..64 (path-safe; becomes the id)",
            "backend": "\"vanilla\"|\"endstone\"",
            "deployment": "\"native\"|\"docker\"|\"systemd\" (default native)",
            "port": "int UDP port, 0 = auto-pick (default 0)",
            "memory_mb": "int? soft resource cap",
            "cpus": "float? soft resource cap",
            "autostart": "bool? (systemd deployment only)",
            "vanilla_version": "string? BDS version to pin"
          }
        },
        "responses": { "200": { "description": "Instance summary" } }
      }
    },
    "/instances/{id}": {
      "get": {
        "tags": ["instances"],
        "summary": "One instance summary + usage",
        "x-permission": "instance access",
        "responses": { "200": { "description": "Instance summary" } }
      },
      "put": {
        "tags": ["instances"],
        "summary": "Update editable fields and/or replace the access list. access requires the instance owner, a panel owner, or INSTANCES_SHARE; name/port/deployment/memory_mb/cpus require the owner path or INSTANCES_LIMITS. Port changes need the instance stopped.",
        "x-permission": "INSTANCES_LIMITS | INSTANCES_SHARE | owner",
        "requestBody": {
          "x-body": {
            "name": "string?",
            "port": "int?",
            "deployment": "\"native\"|\"docker\"|\"systemd\"?",
            "autostart": "bool? (systemd only)",
            "memory_mb": "int?",
            "cpus": "float?",
            "access": "[{user: \"username\", roles: [\"viewer\"|\"instance-manager\"|<catalog role name>\"]}? — full replacement of the share list; empty array revokes everyone]"
          }
        },
        "responses": { "200": { "description": "Updated instance summary" } }
      },
      "delete": {
        "tags": ["instances"],
        "summary": "Delete an instance (owner, panel owner, or INSTANCES_DELETE)",
        "x-permission": "INSTANCES_DELETE | owner",
        "x-query": { "confirm": "\"yes\" required", "keep_data": "\"1\" keeps files on disk" },
        "responses": { "200": { "description": "{success, message}" } }
      }
    },
