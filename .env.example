# Blank SECRET_KEY generates a private persisted key. Set a random 32+ character
# secret to retain existing JWT signing during migration.
SECRET_KEY=
# CurseForge Core API key from https://console.curseforge.com. Enables the
# Store tab; /mods/search needs CurseForge's developer search approval.
CURSEFORGE_API_KEY=
# Only used when there are no users. Blank generates and prints a one-time password.
ADMIN_PASSWORD=
DEBUG=false
OMNI_HOST=0.0.0.0
OMNI_PORT=17754
CORS_ORIGINS=http://localhost:17755,http://localhost:5173,http://localhost:3000
BEDROCK_SERVER_DIR=./bedrock_server
DATA_DIR=./backend/data
BACKUPS_DIR=./backend/backups
LOGS_DIR=./backend/logs
# Set to a standalone executable or your existing Endstone venv's executable.
# ENDSTONE_BIN=/absolute/path/to/.venv/bin/endstone
ENDSTONE_PYTHON=python3
# MCXboxBroadcast standalone (optional). Home of config.yml, screenshot.jpg,
# cache/, and by default MCXboxBroadcastStandalone.jar itself.
BROADCASTER_DIR=./backend/broadcaster
# Absolute jar path override (defaults to $BROADCASTER_DIR/MCXboxBroadcastStandalone.jar).
# BROADCASTER_JAR=/absolute/path/to/MCXboxBroadcastStandalone.jar
# Java runtime used to launch the broadcaster (defaults to "java" on PATH).
# JAVA_BIN=/usr/lib/jvm/java-17-openjdk/bin/java
CONSOLE_MAX_LINES=2000
CONSOLE_MAX_BYTES=16777216
CONSOLE_MAX_LINE_BYTES=65536
CONSOLE_JOURNAL_BYTES=268435456
COMMAND_QUEUE_CAPACITY=256
WS_HEARTBEAT_INTERVAL=30
